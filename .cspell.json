{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "dictionaries": ["en_us", "en-gb", "typescript", "node", "bash", "softwareTerms"],
  "flagWords": ["entires:entries"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.angular/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/out-tsc/**",
    "**/.*cache",
    "**/pnpm-lock.yaml",
    "**/pnpm-workspace.yaml"
  ],
  "ignoreRegExpList": ["CStyleComment"],
  "language": "en",
  "version": "0.2",
  "words": [
    "bimeister",
    "collab",
    "contenteditable",
    "Debouncer",
    "dppx",
    "fontsource",
    "fract",
    "knipcache",
    "ngsrc",
    "postcssrc",
    "posthog",
    "prettiercache",
    "Renderable",
    "sibe",
    "svgjs",
    "Thenables",
    "unlisten",
    "Usakov",
    "WCAG",
    "webgpu",
    "xlink",
    "xxyy",
    "yyxx"
  ]
}
