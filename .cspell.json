{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "dictionaries": ["en_us", "en-gb", "typescript", "node", "bash", "softwareTerms"],
  "flagWords": ["entires:entries"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.angular/**",
    "**/coverage/**",
    "**/out-tsc/**",
    "**/.*cache",
    "**/pnpm-lock.yaml",
    "**/pnpm-workspace.yaml"
  ],
  "ignoreRegExpList": ["CStyleComment"],
  "import": [
    "@cspell/dict-css/cspell-ext.json",
    "@cspell/dict-docker/cspell-ext.json",
    "@cspell/dict-filetypes/cspell-ext.json",
    "@cspell/dict-fonts/cspell-ext.json",
    "@cspell/dict-fullstack/cspell-ext.json",
    "@cspell/dict-gaming-terms/cspell-ext.json",
    "@cspell/dict-git/cspell-ext.json",
    "@cspell/dict-html/cspell-ext.json",
    "@cspell/dict-html-symbol-entities/cspell-ext.json",
    "@cspell/dict-lorem-ipsum/cspell-ext.json",
    "@cspell/dict-markdown/cspell-ext.json",
    "@cspell/dict-node/cspell-ext.json",
    "@cspell/dict-npm/cspell-ext.json",
    "@cspell/dict-software-terms/cspell-ext.json",
    "@cspell/dict-typescript/cspell-ext.json"
  ],
  "language": "en",
  "version": "0.2",
  "words": [
    "bimeister",
    "collab",
    "contenteditable",
    "fontsource",
    "fract",
    "knipcache",
    "ngsrc",
    "posthog",
    "prettiercache",
    "Renderable",
    "sibe",
    "svgjs",
    "Thenables",
    "unlisten",
    "Usakov",
    "WCAG",
    "xlink",
    "xxyy",
    "yyxx"
  ]
}
