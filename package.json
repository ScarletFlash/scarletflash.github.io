{
  "name": "application",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "check-all": "pnpm run compiler__check && pnpm run linter__check && pnpm run formatter__check && pnpm run spell-checker__check && pnpm run dependencies-checker__check",
    "fix-all": "pnpm run linter__fix && pnpm run formatter__fix",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "sourcemap:inject": "posthog-cli sourcemap inject --directory dist/application/browser",
    "sourcemap:upload": "posthog-cli sourcemap upload --directory dist/application/browser --delete-after",
    "compiler__check": "ngc --project tsconfig.app.json --noEmit",
    "linter__check": "ng lint --quiet --cache --cache-strategy content",
    "linter__fix": "ng lint --quiet --cache --cache-strategy content --fix",
    "formatter__check": "prettier --config .prettierrc.mjs --ignore-path .prettierignore --cache --cache-location .prettiercache --cache-strategy content --check .",
    "formatter__fix": "prettier --config .prettierrc.mjs --ignore-path .prettierignore --cache --cache-location .prettiercache --cache-strategy content --write .",
    "spell-checker__check": "cspell lint --config .cspell.json --cache --cache-location .cspellcache --no-progress .",
    "dependencies-checker__check": "knip --strict --cache --cache-location .knipcache",
    "prettier": "prettier"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@tanstack/pacer": "^0.23.1",
    "feather-icons": "^4.0.0",
    "motion": "^14.14.0",
    "posthog-js": "^1.454.2",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "tslib": "^2.9.1",
    "wheel-gestures": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-server": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@cspell/dict-css": "^4.1.2",
    "@cspell/dict-docker": "^1.1.17",
    "@cspell/dict-filetypes": "^3.0.18",
    "@cspell/dict-fonts": "^4.0.6",
    "@cspell/dict-fullstack": "^3.2.9",
    "@cspell/dict-gaming-terms": "^1.1.3",
    "@cspell/dict-git": "^3.1.1",
    "@cspell/dict-html": "^4.0.16",
    "@cspell/dict-html-symbol-entities": "^4.0.5",
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@cspell/dict-markdown": "^2.0.18",
    "@cspell/dict-node": "^5.0.9",
    "@cspell/dict-npm": "^5.2.58",
    "@cspell/dict-software-terms": "^5.4.11",
    "@cspell/dict-typescript": "^3.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/catamaran": "^5.3.0",
    "@posthog/cli": "^0.20.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "angular-eslint": "^22.8.0",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-no-mercy": "^0.0.10",
    "eslint-plugin-unicorn": "^80.0.0",
    "knip": "^6.48.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-sort-json": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "pnpm": "12.23.0",
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
