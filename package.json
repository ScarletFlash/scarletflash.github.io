{
  "name": "application",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:application": "node dist/application/server/server.mjs",
    "sourcemap:inject": "posthog-cli sourcemap inject --directory dist/application/browser",
    "sourcemap:upload": "posthog-cli sourcemap upload --directory dist/application/browser --delete-after"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-server": "^22.0.5",
    "@angular/router": "^22.0.5",
    "@angular/ssr": "^22.0.5",
    "@tailwindcss/postcss": "^4.3.2",
    "express": "^5.1.0",
    "feather-icons": "^4.0.0",
    "posthog-js": "^1.396.6",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@fontsource-variable/catamaran": "^5.2.8",
    "@posthog/cli": "^0.7.34",
    "@types/express": "^5.0.1",
    "@types/node": "^26.0.0",
    "@types/three": "^0.185.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2"
  },
  "engines": {
    "pnpm": "9.12.2",
    "node": "26.4.0"
  },
  "packageManager": "pnpm@9.12.2"
}
