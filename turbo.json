{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [
    "!./node_modules/",
    "!.cspellcache",
    "!.eslintcache",
    "!.knipcache",
    "!.prettiercache",
    "!.turbo/**/*",
    ".cspell.json",
    ".editorconfig",
    ".gitignore",
    ".npmrc",
    ".postcssrc.json",
    ".prettierignore",
    ".prettierrc.mjs",
    "angular.json",
    "eslint*.mjs",
    "knip.json",
    "pnpm-*.yaml",
    "tsconfig*.json",
    "turbo.json"
  ],
  "tasks": {
    "_check-all": {
      "cache": false,
      "dependsOn": [
        "dependencies-checker__check",
        "compiler__check",
        "linter__check",
        "formatter__check",
        "spell-checker__check"
      ],
      "outputLogs": "errors-only"
    },
    "_fix-all": {
      "cache": false,
      "dependsOn": ["linter__fix", "formatter__fix"],
      "outputLogs": "errors-only"
    },
    "compiler__check": {
      "cache": true,
      "inputs": [
        "./**/*.{js,ts,tsx,html}",
        "./**/tsconfig.*",
        "./package.json",
        "!./node_modules/",
        "!./out-tsc/",
        "!./dist/",
        "!./.angular/"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "dependencies-checker__check": {
      "cache": true,
      "inputs": [
        "./**/*.{js,mjs,ts,mts,tsx}",
        "./**/package.json",
        "./**/tsconfig*.json",
        "./.github/workflows/*",
        "./knip.json",
        "!./**/node_modules/",
        "!./**/out-tsc/",
        "!./**/dist/",
        "!./**/.angular/"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "formatter__check": {
      "cache": true,
      "inputs": [
        "./**/*.{js,mjs,ts,mts,tsx,html,css,yaml,yml,json,jsonc,md}",
        "!./node_modules/",
        "!./out-tsc/",
        "!./dist/",
        "!./.angular/",
        "!./.turbo/"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "formatter__fix": {
      "cache": true,
      "dependsOn": ["linter__fix"],
      "inputs": [
        "./**/*.{js,mjs,ts,mts,tsx,html,css,yaml,yml,json,jsonc,md}",
        "!./node_modules/",
        "!./out-tsc/",
        "!./dist/",
        "!./.angular/",
        "!./.turbo/",
        "!./turbo.json"
      ],
      "outputLogs": "errors-only",
      "outputs": [
        "./**/*.{js,mjs,ts,mts,tsx,html,css,yaml,yml,json,jsonc,md}",
        "!./node_modules/",
        "!./out-tsc/",
        "!./dist/",
        "!./.angular/",
        "!./.turbo/",
        "!./turbo.json"
      ]
    },
    "linter__check": {
      "cache": true,
      "inputs": ["./**/*.{js,mjs,ts,mts,tsx,html}", "!./node_modules/", "!./out-tsc/", "!./dist/", "!./.angular/"],
      "outputLogs": "errors-only",
      "outputs": []
    },
    "linter__fix": {
      "cache": true,
      "inputs": ["./**/*.{js,mjs,ts,mts,tsx,html}", "!./node_modules/", "!./out-tsc/", "!./dist/", "!./.angular/"],
      "outputLogs": "errors-only",
      "outputs": ["./**/*.{js,mjs,ts,mts,tsx,html}", "!./node_modules/", "!./out-tsc/", "!./dist/", "!./.angular/"]
    },
    "spell-checker__check": {
      "cache": true,
      "inputs": [
        "./**/*",
        "!./node_modules/",
        "!./out-tsc/",
        "!./dist/",
        "!./.angular/",
        "!./.git",
        "!./.turbo/",
        "!./.*cache"
      ],
      "outputLogs": "errors-only",
      "outputs": []
    }
  },
  "ui": "stream"
}
